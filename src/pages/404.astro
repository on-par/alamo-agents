---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found | Alamo Agents"
  description="That page doesn't exist on alamoagents.org."
>
  <section class="page-hero not-found">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>Page not found.</h1>
      <p class="lede">The page you're looking for doesn't exist or has moved.</p>
      <div class="hero-actions">
        <a class="btn btn-solid" href="/">Go to the home page</a>
        <a class="btn" href="/events">See events</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    min-height: 60vh;
  }
</style>
