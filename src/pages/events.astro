---
import Layout from '../layouts/Layout.astro';
import { lumaCalendarEmbedUrl, lumaUrl } from '../site-config';

const lumaCalendarUrl = 'https://luma.com/alamo-agents';
---

<Layout
  title="Events | Alamo Agents"
  description="Alamo Agents gathers in San Antonio, Texas. See upcoming gatherings and RSVP on Luma."
>
  <section class="page-hero on-light">
    <div class="wrap reveal">
      <p class="eyebrow">Events</p>
      <h1>Where Texas comes together on agent systems.</h1>
      <p class="lede">
        When Alamo Agents gathers in San Antonio, it's small, in-person, and built around real
        work: demos, not slide decks.
      </p>
    </div>
  </section>

  <section>
    <div class="wrap reveal">
      {
        lumaCalendarEmbedUrl ? (
          <div class="luma-embed">
            <iframe
              src={lumaCalendarEmbedUrl}
              width="100%"
              height="600"
              frameborder="0"
              allowfullscreen
              title="Alamo Agents events calendar"
            />
            <noscript>
              <p class="embed-fallback">
                Can't see the calendar? <a href={lumaCalendarUrl}>View events on Luma</a>
                {lumaUrl && <> or <a href={lumaUrl}>RSVP for the next event</a></>}.
              </p>
            </noscript>
            <p class="embed-fallback embed-fallback--visible">
              <a href={lumaCalendarUrl}>View calendar on Luma</a>
              {lumaUrl && <> · <a href={lumaUrl}>RSVP for the next event</a></>}
            </p>
          </div>
        ) : (
          <div class="card events-placeholder">
            <h3>Calendar coming soon</h3>
            <p>
              We're setting up our Luma calendar so every gathering lives in one place. Once the
              inaugural meetup is scheduled, it and every one after it will show up here first.
            </p>
          </div>
        )
      }
    </div>
  </section>
</Layout>
