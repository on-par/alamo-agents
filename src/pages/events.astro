---
import Layout from '../layouts/Layout.astro';
import { lumaCalendarEmbedUrl, lumaUrl, nightOneTalkUrl } from '../site-config';

const lumaCalendarUrl = 'https://luma.com/alamo-agents';

// Luma's dark theme (lt=dark) so the embed matches the obsidian page.
const lumaEmbedSrc = lumaCalendarEmbedUrl
  ? `${lumaCalendarEmbedUrl}${lumaCalendarEmbedUrl.includes('?') ? '&' : '?'}lt=dark`
  : '';
---

<Layout
  title="Events | Alamo Agents"
  description="Alamo Agents gathers in San Antonio, Texas. Past nights and the calendar for what's next."
>
  <section class="page-hero on-light">
    <div class="wrap reveal">
      <p class="eyebrow">Events</p>
      <h1>Where Texas comes together on agent systems.</h1>
      <p class="lede">
        When Alamo Agents gathers in San Antonio, it's small, in-person, and built around real
        work: demos, not slide decks.
      </p>
    </div>
  </section>

  <section class="next-event">
    <div class="wrap reveal">
      <p class="eyebrow">Up next</p>
      <div class="event-card">
        <div class="event-card-main">
          <h2>Agents That Live With You</h2>
        <dl class="event-meta">
          <div>
            <dt>When</dt>
            <dd>Tue Oct 13, 2026 · 6:00–7:30pm CT</dd>
          </div>
          <div>
            <dt>Where</dt>
            <dd>Zelifcam, 10200 San Pedro Ave, San Antonio</dd>
          </div>
        </dl>
        </div>
        <div class="event-card-aside">
        <p class="lede">
          Join us for the next Alamo Agents night in San Antonio.
        </p>
        {
          lumaUrl && (
            <a class="btn btn-solid" href={lumaUrl}>
              RSVP on Luma
            </a>
          )
        }
        </div>
      </div>
    </div>
  </section>

  <section class="on-light">
    <div class="wrap reveal">
      <p class="eyebrow">Past</p>
      <div class="event-card">
        <div class="event-card-main">
          <h2>Software Factories</h2>
        <dl class="event-meta">
          <div>
            <dt>When</dt>
            <dd>Tue Sep 8, 2026 · 6:00–7:30pm CT</dd>
          </div>
          <div>
            <dt>Where</dt>
            <dd>Zelifcam, 10200 San Pedro Ave, San Antonio</dd>
          </div>
        </dl>
        </div>
        <div class="event-card-aside">
        <p class="lede">
          Night One is done — thanks for coming.
        </p>
        <a class="btn" href={nightOneTalkUrl}>
          Watch the talk
        </a>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap reveal">
      {
        lumaCalendarEmbedUrl ? (
          <>
          <div class="section-intro">
            <p class="eyebrow">All events</p>
            <h2>Calendar</h2>
            <p class="lede">Every upcoming Alamo Agents event, from our Luma calendar.</p>
          </div>
          <div class="luma-embed" id="luma-embed">
            <div class="luma-embed-frame">
              <div class="luma-loading" aria-hidden="true">
                <span class="luma-spinner"></span>
                <span>Loading calendar…</span>
              </div>
              <iframe
                id="luma-embed-iframe"
                src={lumaEmbedSrc}
                width="100%"
                height="260"
                frameborder="0"
                allowfullscreen
                loading="lazy"
                title="Alamo Agents events calendar"
              />
            </div>
            <script src="/js/luma-embed.js" is:inline></script>
            <noscript>
              <p class="embed-fallback">
                Can't see the calendar? <a href={lumaCalendarUrl}>View events on Luma</a>
                {lumaUrl && <> or <a href={lumaUrl}>RSVP for the next event</a></>}.
              </p>
            </noscript>
            <p class="embed-fallback embed-fallback--visible">
              <a href={lumaCalendarUrl}>View calendar on Luma</a>
              {lumaUrl && <> · <a href={lumaUrl}>RSVP for the next event</a></>}
            </p>
          </div>
          </>
        ) : (
          <div class="card events-placeholder">
            <h3>Calendar coming soon</h3>
            <p>
              We're setting up our Luma calendar so every gathering lives in one place. Once the
              next meetup is scheduled, it and every one after it will show up here first.
            </p>
          </div>
        )
      }
    </div>
  </section>
</Layout>
