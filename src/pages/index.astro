---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { lumaUrl, nightOneTalkUrl } from '../site-config';
import heroArch from '../assets/hero-arch.png';

const pillars = [
  {
    title: 'Show your work',
    body: 'Demo unfinished ideas, prototypes, workflows, and production systems. Progress over polish.',
  },
  {
    title: 'Steal good ideas',
    body: 'Short talks and live demos from people shipping agent systems for real. Architectures, tooling, and workflows you can steal.',
  },
  {
    title: 'Find collaborators',
    body: 'Meet engineers, founders, and researchers working on the same problems you are.',
  },
];
---

<Layout
  title="Alamo Agents | Where Texas Builds Agent Systems"
  description="A San Antonio gathering for people building AI agent systems."
  ogDescription="A San Antonio gathering for people building agent systems. No pitches, no fluff, just what you built and what you learned building it."
>
  <section class="hero">
    <div class="wrap">
      <div class="hero-copy reveal">
        <h1>
          Where Texas <span class="accent">builds</span> agent systems.
        </h1>
        <p class="lede">
          Alamo Agents is a gathering for people building agent systems, workflows, and tools. No
          pitches. No fluff. Just what you shipped and what you learned shipping it.
        </p>
        <div class="hero-actions">
          {
            lumaUrl && (
              <a class="btn btn-solid" href={lumaUrl}>
                RSVP on Luma
              </a>
            )
          }
          <a class={lumaUrl ? 'btn' : 'btn btn-solid'} href="/about">
            About the community
          </a>
        </div>
      </div>
      <div class="diagram-card reveal" aria-hidden="true">
        <Image src={heroArch} alt="" class="hero-arch" />
      </div>
    </div>
  </section>

  <section id="up-next" class="on-light">
    <div class="wrap reveal">
      <p class="eyebrow">Up next</p>
      <div class="night-one-panel">
        <h2>Agents That Live With You</h2>
        <dl class="event-meta">
          <div>
            <dt>When</dt>
            <dd>Tue Oct 13, 2026 · 6:00–7:30pm CT</dd>
          </div>
          <div>
            <dt>Where</dt>
            <dd>Zelifcam, 10200 San Pedro Ave, San Antonio</dd>
          </div>
        </dl>
        <p class="lede" style="margin-top: 1rem;">
          Join us for the next Alamo Agents night in San Antonio.
        </p>
        {
          lumaUrl && (
            <a class="btn btn-solid" href={lumaUrl} style="margin-top: 0.75rem;">
              RSVP on Luma
            </a>
          )
        }
      </div>
    </div>
  </section>

  <section id="night-one">
    <div class="wrap reveal">
      <p class="eyebrow">Night One · Past</p>
      <div class="night-one-panel">
        <h2>Software Factories</h2>
        <dl class="event-meta">
          <div>
            <dt>When</dt>
            <dd>Tue Sep 8, 2026 · 6:00–7:30pm CT</dd>
          </div>
          <div>
            <dt>Where</dt>
            <dd>Zelifcam, 10200 San Pedro Ave, San Antonio</dd>
          </div>
        </dl>
        <p class="lede" style="margin-top: 1rem;">
          Thanks to everyone who showed up for Night One.
        </p>
        <a class="btn" href={nightOneTalkUrl} style="margin-top: 0.75rem;">
          Watch the talk
        </a>
      </div>
    </div>
  </section>

  <section id="expect">
    <div class="wrap">
      <div class="reveal">
        <p class="eyebrow">What to expect</p>
        <h2>Show up, build, compare notes.</h2>
      </div>
      <div class="grid-3">
        {
          pillars.map((p) => (
            <div class="card reveal">
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="join" class="on-light">
    <div class="wrap reveal">
      <p class="eyebrow">Join</p>
      <div class="join-panel">
        <h2>Agents That Live With You — Oct 13.</h2>
        {
          lumaUrl ? (
            <>
              <p class="lede">
                RSVP below to save your seat for the next Alamo Agents night in San Antonio.
              </p>
              <a class="btn btn-solid" href={lumaUrl}>
                RSVP on Luma
              </a>
            </>
          ) : (
            <>
              <p class="lede">
                Watch the events page for the next date, or get in touch if you want to demo,
                sponsor, or say hi.
              </p>
              <div class="hero-actions" style="justify-content: flex-start; margin-top: 1rem;">
                <a class="btn btn-solid" href="/events">
                  See events
                </a>
                <a class="btn" href="/contact">
                  Get in touch
                </a>
              </div>
            </>
          )
        }
      </div>
    </div>
  </section>
</Layout>
